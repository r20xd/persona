# Private copy outside the repository, mode 0600. Never use these placeholders.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-independent-random-secret
DJANGO_ALLOWED_HOSTS=replace-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://replace-domain.example
DJANGO_TRUSTED_PROXY_CIDRS=172.30.90.0/28
DB_NAME=deanery
DB_USER=deanery_app
DB_PASSWORD=replace-app-random-password
DB_HOST=db
DB_PORT=5432
POSTGRES_USER=deanery_bootstrap
POSTGRES_PASSWORD=replace-bootstrap-independent-password
POSTGRES_DB=postgres

# Reviewed immutable derived image references and exact public domain:
APP_IMAGE=replace-app-image-reference
POSTGRES_IMAGE=replace-postgres-config-image-reference
CADDY_IMAGE=replace-caddy-config-image-reference
SITE_DOMAIN=replace-domain.example
