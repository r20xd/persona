{
	admin off
	# Unselected modules stay silent; only audited operational scopes below emit.
	log default {
		output stdout
		exclude * .
		import safe_operational_format
	}
	log tls_events {
		output stdout
		level INFO
		include tls.cache.maintenance tls.obtain
		import safe_operational_format
	}
	# Handled reverse-proxy faults are DEBUG in Caddy; no global debug mode.
	log handled_faults {
		output stdout
		level DEBUG
		include http.log.error
		import safe_operational_format
	}
	servers {
		timeouts {
			read_header 10s
			read_body 30s
			write 120s
			idle 60s
		}
		max_header_size 16KB
	}
}
{$SITE_DOMAIN} {
	request_body {
		max_size 64KiB
	}
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}
	reverse_proxy app:8000 {
		header_up -Forwarded
		header_up -X-Forwarded-For
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
		transport http {
			dial_timeout 3s
			response_header_timeout 110s
			read_timeout 110s
			write_timeout 30s
		}
	}
	handle_errors {
		header Cache-Control no-store
		@health path /health/live/ /health/ready/
		handle @health {
			header Content-Type application/json
			respond `{"status":"unavailable"}` {err.status_code}
		}
		handle {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
			<!doctype html>
			<html lang="ru">
			<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="robots" content="noindex, nofollow"><title>Сервис временно недоступен · persōna</title></head>
			<body>
			<main><p>persōna</p><h1>Сервис временно недоступен</h1><p>Попробуйте вернуться в кабинет немного позже.</p><p><a href="/">Вернуться в кабинет</a></p></main>
			<footer><p>Конкурсный концепт · Неофициальный сервис</p></footer>
			</body></html>
			HTML {err.status_code}
		}
	}
}
