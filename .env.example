# Copy to .env and replace placeholders. Never commit actual values.
# Django does not load this file automatically; source it as documented in README.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-random-local-secret
DJANGO_DEBUG=0
DB_NAME=deanery
DB_USER=deanery
DB_PASSWORD=replace-with-random-local-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Tests ignore DB_*; use only a disposable local PostgreSQL service/account.
TEST_DB_NAME=test_deanery
TEST_DB_USER=deanery
TEST_DB_PASSWORD=replace-with-local-test-password
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
# Production only; requires independent secrets and all DB_* values.
DJANGO_ALLOWED_HOSTS=concept.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://concept.example.org
# Bootstrap only: supply privately or leave unset for interactive hidden prompts.
# Never place actual passwords in this tracked file.
DEMO_STUDENT_ONE_PASSWORD=replace-with-unique-demo-password
DEMO_STUDENT_TWO_PASSWORD=replace-with-another-unique-demo-password
DEMO_OPERATOR_PASSWORD=replace-with-unique-operator-password

# Production requires the complete explicit config in deploy/production.env.example.

# Optional AI chat: all three must be set on the server; never put the key in HTML/JS.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
